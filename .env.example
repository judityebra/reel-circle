# Browser-visible URL of the server-side movie API. Use /api when deployed on Vercel.
VITE_MOVIE_API_URL=/api
# Number of 20-film TMDB pages loaded into the ranking pool (1-20).
VITE_MOVIE_CATALOG_PAGES=10

# Server-only. Configure in the deployment environment; never prefix with VITE_.
TMDB_BEARER_TOKEN=
# Alternatively, use the 32-character TMDB v3 key.
TMDB_API_KEY=

# Optional server-only OpenAI-compatible model configuration.
# Without a key, /api/agent uses the deterministic structured extractor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Override only for another OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional semantic embedding provider. Groq currently does not expose embeddings,
# so configure a separate OpenAI-compatible provider for neural vectors.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# Free Gemini alternative:
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768

# Optional persistent vector store. Without this, vectors are searched in memory.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=reel-circle-movies
# Optional LangSmith tracing for the Python recommendation agent (agent-service/).
# Off unless LANGSMITH_TRACING=true; then every graph node of every turn is traced.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=reel-circle-agent

# Optional server-only URL of the Python recommendation agent (agent-service/).
# When set, /api/agent forwards each turn there and falls back to the TypeScript
# pipeline on an error or timeout; meta.agentService says which one answered.
AGENT_SERVICE_URL=
AGENT_SERVICE_TIMEOUT_MS=4000

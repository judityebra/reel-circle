# Browser-visible URL of the server-side movie API. Use /api when deployed on Vercel.
VITE_MOVIE_API_URL=/api
# Number of 20-film TMDB pages loaded into the ranking pool (1-20).
VITE_MOVIE_CATALOG_PAGES=10

# Server-only. Configure in the deployment environment; never prefix with VITE_.
TMDB_BEARER_TOKEN=
# Alternatively, use the 32-character TMDB v3 key.
TMDB_API_KEY=

# Optional server-only OpenAI-compatible model configuration.
# Without a key, /api/agent uses the deterministic structured extractor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Override only for another OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1